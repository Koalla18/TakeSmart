# ──────────────────────────────────────────────────────────────────────────────
# TakeSmart — Production Environment Variables
# Copy this file to .env and fill in the values BEFORE running docker compose up
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=take_smart
POSTGRES_USER=take_smart
# ⚠️  Change this to a strong password!
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
# No external config needed — Redis runs internally

# ── Backend ───────────────────────────────────────────────────────────────────
# ⚠️  Change these secrets!
JWT_SECRET=CHANGE_ME_very_long_random_string_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password_here

# Comma-separated list of allowed CORS origins
# Use your real domain, e.g.: https://takesmart.ru,https://www.takesmart.ru
ALLOWED_ORIGINS=https://YOUR_DOMAIN.COM

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Leave EMPTY for production — nginx handles routing (relative /api/ URLs)
# Or set to your domain if you deploy frontend separately:
# VITE_API_BASE_URL=https://YOUR_DOMAIN.COM
VITE_API_BASE_URL=
