# ──────────────────────────────────────────────────────────────────────────────
# Dockerfile — TakeSmart Frontend (Timeweb App Platform)
#
# Для деплоя: положите этот файл в корень репо (или в отдельную ветку frontend).
# Timeweb прочитает его автоматически.
#
# Env-переменные задаются в панели Timeweb → Приложение → Настройки:
#   BACKEND_HOST  — внутренний IP backend-приложения (напр. 192.168.0.3)
# ──────────────────────────────────────────────────────────────────────────────

# ─── Stage 1: Build React SPA ────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --prefer-offline

COPY frontend/ .
RUN npm run build

# ─── Stage 2: Nginx — serve SPA + proxy /api/ → backend ─────────────────────
FROM nginx:1.27-alpine

# Built SPA
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config as template (${BACKEND_HOST} will be substituted at runtime)
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf.template

# Remove default config
RUN rm -f /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf.dpkg-old

EXPOSE 80

# At container start: substitute BACKEND_HOST in nginx config, then run nginx
CMD ["/bin/sh", "-c", "BACKEND_HOST=${BACKEND_HOST:-backend} envsubst '${BACKEND_HOST}' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
