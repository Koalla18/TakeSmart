# ═══════════════════════════════════════════════════════════════════════════════
# TakeSmart Backend — пример переменных окружения
# Скопируйте в .env и заполните значения
# ═══════════════════════════════════════════════════════════════════════════════

# ─── База данных ──────────────────────────────────────────────────────────────
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://take_smart:take_smart_password@localhost:5432/take_smart

# ─── Redis ────────────────────────────────────────────────────────────────────
# Оставьте пустым — rate limiting и кэш будут отключены
REDIS_URL=redis://localhost:6379/0

# ─── Администратор ────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО смените перед деплоем!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-set-strong-password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Генерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ─── Медиафайлы ───────────────────────────────────────────────────────────────
# Путь к папке для хранения загруженных изображений
# В Docker — монтируется как volume
STATIC_DIR=/app/static

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Список разрешённых origins через запятую (продакшн домены)
# Оставьте пустым — будут разрешены только localhost:5173/5174/3000
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Telegram уведомления ────────────────────────────────────────────────────
# Опционально — для уведомлений о новых заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
