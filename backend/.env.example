# ═══════════════════════════════════════════════════════════════════════════════
# TakeSmart Backend — пример переменных окружения
# Скопируйте в .env и заполните значения
# ═══════════════════════════════════════════════════════════════════════════════

# ─── База данных ──────────────────────────────────────────────────────────────
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://take_smart:take_smart_password@localhost:5432/take_smart

# ─── Redis ────────────────────────────────────────────────────────────────────
# Оставьте пустым — rate limiting и кэш будут отключены
REDIS_URL=redis://localhost:6379/0

# ─── Администратор ────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО смените перед деплоем!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-set-strong-password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Генерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-with-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Независимый ключ шифрования; при ротации SECRET_KEY укажите прежний ключ в INTEGRATION_LEGACY_KEY до пересохранения настроек Авито
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_LEGACY_KEY=

# ─── S3 хранилище (Timeweb) ───────────────────────────────────────────────────
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_BUCKET_NAME=9fbee474-1fa2-419a-ab9e-e0f8ecde4b7e
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=ru-1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Список разрешённых origins через запятую (продакшн домены)
# Оставьте пустым — будут разрешены только localhost:5173/5174/3000
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Telegram уведомления ────────────────────────────────────────────────────
# Опционально — для уведомлений о новых заказах
TELEGRAM_BOT_TOKEN=
# Предпочтительно: список chat id через запятую
TELEGRAM_CHAT_IDS=
# Обратная совместимость (одно значение)
TELEGRAM_CHAT_ID=
