# ──────────────────────────────────────────────────────────────────────────────
# Dockerfile — TakeSmart Backend (Timeweb App Platform)
#
# Для деплоя: положите этот файл в корень репо (или в отдельную ветку backend).
# Timeweb прочитает его автоматически.
#
# Env-переменные задаются в панели Timeweb → Приложение → Настройки:
#   DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME
#   REDIS_HOST, REDIS_PORT, REDIS_DB, REDIS_PASSWORD
#   SECRET_KEY, ADMIN_USERNAME, ADMIN_PASSWORD
#   ALLOWED_ORIGINS, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
# ──────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# Seed static files (won't be overwritten if volume is mounted)
COPY backend/static /app/static_seed
RUN mkdir -p /app/static/products /app/static/categories

EXPOSE 8000

ENTRYPOINT ["sh", "/app/entrypoint.sh"]
